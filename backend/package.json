{
  "name": "datamet-plus-backend",
  "version": "1.0.0",
  "description": "API de DataMET+ (Node.js, Express y SQL Server)",
  "main": "src/server.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:test": "dotenv -e .env.test -- node --watch src/server.js",
    "start:test": "dotenv -e .env.test -- node src/server.js",
    "migrate": "node scripts/migrate.js",
    "ivmet:access-code": "node scripts/ivmet-access-code.js",
    "ivmet:doctor": "node scripts/ivmet-doctor.js",
    "ivmet:admin-bootstrap": "node scripts/ivmet-admin-bootstrap.js",
    "patrones:importar": "node scripts/patrones-importar-excel.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mssql",
    "datamet"
  ],
  "author": "lenash.dev",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^10.0.2",
    "nodemailer": "^10.0.15",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
