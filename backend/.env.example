PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

DB_SERVER=localhost
DB_USER=datamet_plus_app
DB_PASSWORD=replace-with-a-secure-password
DB_DATABASE=DataMET

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Gestion IvMET: la clave secreta solo pertenece al backend, nunca a VITE_*.
IVMET_ENABLED=false
# Código de pruebas: solo hash bcrypt. Sin configurarlo el gestor permanece bloqueado.
# Generar con pnpm ivmet:access-code dentro de backend; nunca usar una variable VITE_*.
IVMET_ACCESS_CODE_HASH=
# Catálogo corporativo; independiente de DataMET_prueba usado por cronograma.
IVMET_DATAMET_DATABASE=DataMET
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-sb-secret-or-service-role-key
# Compatibilidad temporal: si el proyecto aun usa la clave JWT antigua,
# puede definirse SUPABASE_SERVICE_ROLE_KEY en lugar de SUPABASE_SECRET_KEY.

# Cronograma de calibración: alertas por correo (opcional).
# Sin SMTP_HOST las alertas solo se ven dentro del cronograma.
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (TLS directo); false para 587 con STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente visible, p. ej. "Calibración Métrica <calibracion@metrica.com.bo>".
SMTP_FROM=
# Solo si el servidor usa un certificado interno no reconocido.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# false detiene la revisión diaria de alertas por correo.
CAL_ALERTS_ENABLED=true
# false detiene el correo diario de los próximos servicios de Soporte técnico.
ST_ALERTS_ENABLED=true

# Carpeta del servidor que explora el técnico al guardar cada PDF.
# La cuenta que ejecuta el backend debe poder leer y escribir en ella.
ST_DOCUMENTOS_DIR=D:\OneDrive\SOPORTE TECNICO

# Calibración: carpeta donde se archivan los certificados firmados, en una
# subcarpeta por año (PC-EMIN\2026\…). DataMET+ crea la del año si falta y
# nunca sobrescribe un PDF. La cuenta del backend debe poder leer y escribir.
CAL_DOCUMENTOS_DIR=D:\OneDrive\1. Documentos Sistema de gestión\Registros\PC-EMIN

# Registros RIM: se leen de la misma base DB_DATABASE. Requieren los scripts
# 012, 014 y 016 de ServiceMET en esa base, con este DB_USER en
# @loginDataMetPlus del 014 y del 016.
# Enlace al cronograma incluido en los correos (opcional).
APP_URL=

# Soporte técnico: mejora de redacción de los informes con Google Gemini.
# Clave de Google AI Studio; solo backend, nunca en una variable VITE_*.
# Sin clave, el botón «Mejorar redacción» no aparece.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Se usa si el modelo principal está saturado o no disponible.
GEMINI_MODEL_RESPALDO=gemini-3.5-flash
