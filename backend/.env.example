PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

DB_SERVER=localhost
DB_USER=rimmet_app
DB_PASSWORD=replace-with-a-secure-password
DB_DATABASE=DataMET

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Gestion IvMET: la clave secreta solo pertenece al backend, nunca a VITE_*.
IVMET_ENABLED=false
# Código de pruebas: solo hash bcrypt. Sin configurarlo el gestor permanece bloqueado.
# Generar con pnpm ivmet:access-code dentro de backend; nunca usar una variable VITE_*.
IVMET_ACCESS_CODE_HASH=
# Catálogo corporativo; independiente de DataMET_prueba usado por cronograma.
IVMET_DATAMET_DATABASE=DataMET
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-sb-secret-or-service-role-key
# Compatibilidad temporal: si el proyecto aun usa la clave JWT antigua,
# puede definirse SUPABASE_SERVICE_ROLE_KEY en lugar de SUPABASE_SECRET_KEY.

# Cronograma de calibración: alertas por correo (opcional).
# Sin SMTP_HOST las alertas solo se ven dentro del cronograma.
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (TLS directo); false para 587 con STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente visible, p. ej. "Calibración Métrica <calibracion@metrica.com.bo>".
SMTP_FROM=
# Solo si el servidor usa un certificado interno no reconocido.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# false detiene la revisión diaria de alertas por correo.
CAL_ALERTS_ENABLED=true

# Registros RIM: base de ServiceMET con los RIM (form_rim), en la misma
# instancia. Requiere los scripts 012 y 014 de ServiceMET y que su login
# (DB_USER) figure en @loginDataMetPlus del script 014.
RIM_DB_NAME=servicios_extras
# Enlace al cronograma incluido en los correos (opcional).
APP_URL=
