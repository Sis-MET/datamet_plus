# Copiar a .env.production.local en el servidor ANTES de pnpm build.
# Con valores vacíos, la API utiliza el mismo origen que el frontend:
# https://datamet.lenash.dev/api o los accesos HTTP de la oficina.
# Evita heredar una IP/puerto HTTP de .env o .env.local en el build HTTPS.
VITE_API_URL=
VITE_API_PORT=
